# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/splitease

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key_here

# Frontend Client URL (for CORS in production, e.g. Vercel deployment)
# CLIENT_URL=https://your-splitease-app.vercel.app

