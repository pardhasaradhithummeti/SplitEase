# Backend Environment Variables (create server/.env)
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/splitease
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/splitease?retryWrites=true&w=majority
JWT_SECRET=your_secure_jwt_secret_key
# CLIENT_URL=https://your-splitease-app.vercel.app

# Frontend Environment Variables (optional in dev, set to Render backend URL in Vercel)
# VITE_API_URL=https://your-splitease-api.onrender.com/api

